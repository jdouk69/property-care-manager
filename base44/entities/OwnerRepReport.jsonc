{
  "name": "OwnerRepReport",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "contractor_id": {
      "type": "string"
    },
    "visit_date": {
      "type": "string",
      "format": "date"
    },
    "expected_work": {
      "type": "string"
    },
    "observed_progress": {
      "type": "string"
    },
    "work_completed": {
      "type": "string"
    },
    "visible_concerns": {
      "type": "string"
    },
    "delays": {
      "type": "string"
    },
    "questions_for_owner": {
      "type": "string"
    },
    "questions_for_contractor": {
      "type": "string"
    },
    "recommendations": {
      "type": "string"
    },
    "before_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "during_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "after_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent"
      ],
      "default": "Draft"
    },
    "description": {
      "type": "string",
      "description": "Optional free-text description (up to 1000 characters).",
      "maxLength": 1000
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}