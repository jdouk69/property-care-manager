{
  "name": "Contractor",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "trade": {
      "type": "string",
      "enum": [
        "Plumber",
        "Electrician",
        "Pool Technician",
        "Gardener",
        "Cleaner",
        "Locksmith",
        "HVAC",
        "Pest Control",
        "Roofer",
        "Painter",
        "General Handyman",
        "Appliance Repair",
        "Internet / Telecom",
        "Other"
      ],
      "default": "Other"
    },
    "service_area": {
      "type": "string"
    },
    "languages": {
      "type": "string"
    },
    "availability": {
      "type": "string"
    },
    "emergency_availability": {
      "type": "string"
    },
    "trusted_rating": {
      "type": "number"
    },
    "linked_jobs": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "company"
  ]
}