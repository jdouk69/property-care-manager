{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Inspection",
        "Maintenance",
        "Maintenance follow-up",
        "Contractor Meeting",
        "Delivery",
        "Owner Request",
        "Arrival preparation",
        "Departure inspection",
        "Shopping",
        "Utility payment",
        "Report",
        "Key return",
        "Phone call",
        "Owner-representative visit",
        "Custom"
      ],
      "default": "Custom"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "assigned_to": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "recurring": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_id": {
      "type": "string"
    },
    "occurrence_date": {
      "type": "string",
      "format": "date"
    },
    "recurrence_status": {
      "type": "string",
      "enum": [
        "active",
        "skipped",
        "ended"
      ],
      "default": "active"
    },
    "repeat_label": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}