{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Inspection",
        "Contractor Meeting",
        "Delivery",
        "Shopping",
        "Owner Request",
        "Maintenance",
        "Custom"
      ],
      "default": "Custom"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "assigned_to": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "recurring": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_id": {
      "type": "string"
    },
    "occurrence_date": {
      "type": "string",
      "format": "date"
    },
    "recurrence_status": {
      "type": "string",
      "enum": [
        "active",
        "skipped",
        "ended"
      ],
      "default": "active"
    },
    "repeat_label": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}