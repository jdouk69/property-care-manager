{
  "name": "Property",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "gps_coordinates": {
      "type": "string"
    },
    "maps_link": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "Villa",
        "Apartment",
        "House",
        "Studio",
        "Cottage",
        "Commercial"
      ],
      "default": "Villa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Vacant",
        "Owner Occupied",
        "Guest Occupied",
        "Rental Occupied",
        "Preparing for Arrival",
        "Preparing for Departure",
        "Under Maintenance",
        "Emergency",
        "Inactive"
      ],
      "default": "Vacant"
    },
    "condition": {
      "type": "string",
      "enum": [
        "Excellent",
        "Good",
        "Needs Attention",
        "Poor"
      ],
      "default": "Good"
    },
    "primary_photo": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_code": {
      "type": "string"
    },
    "lockbox_code": {
      "type": "string"
    },
    "key_location": {
      "type": "string"
    },
    "alarm_instructions": {
      "type": "string"
    },
    "alarm_company": {
      "type": "string"
    },
    "security_camera": {
      "type": "string"
    },
    "wifi_ssid": {
      "type": "string"
    },
    "wifi_password": {
      "type": "string"
    },
    "electricity_provider": {
      "type": "string"
    },
    "electricity_account": {
      "type": "string"
    },
    "water_provider": {
      "type": "string"
    },
    "water_account": {
      "type": "string"
    },
    "internet_provider": {
      "type": "string"
    },
    "internet_account": {
      "type": "string"
    },
    "heating_fuel": {
      "type": "string"
    },
    "septic_details": {
      "type": "string"
    },
    "utility_shutoff": {
      "type": "string"
    },
    "pool_details": {
      "type": "string"
    },
    "pool_equipment": {
      "type": "string"
    },
    "irrigation": {
      "type": "string"
    },
    "garden_details": {
      "type": "string"
    },
    "air_conditioning_units": {
      "type": "string"
    },
    "heating": {
      "type": "string"
    },
    "solar_water_heater": {
      "type": "string"
    },
    "appliances": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "water_tanks": {
      "type": "string"
    },
    "pumps": {
      "type": "string"
    },
    "security_system": {
      "type": "string"
    },
    "service_package_id": {
      "type": "string"
    },
    "monthly_fee": {
      "type": "number"
    },
    "inspection_frequency": {
      "type": "string"
    },
    "included_services": {
      "type": "string"
    },
    "additional_service_charges": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    },
    "special_notes": {
      "type": "string"
    },
    "monitoring_priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "include_in_recurring": {
            "type": "boolean",
            "default": false
          },
          "recurring_check_text": {
            "type": "string"
          },
          "recurring_visit_type": {
            "type": "string"
          }
        },
        "required": [
          "area"
        ]
      }
    },
    "monitoring_plan_confirmed_at": {
      "type": "string"
    },
    "monitoring_plan_visit_type": {
      "type": "string"
    },
    "monitoring_plan_confirmed_by": {
      "type": "string"
    },
    "assessment_interior_size": {
      "type": "string",
      "enum": [
        "Under 100 m\u00b2",
        "100\u2013200 m\u00b2",
        "200\u2013300 m\u00b2",
        "300+ m\u00b2"
      ]
    },
    "assessment_additional_units": {
      "type": "number",
      "default": 0
    },
    "assessment_complexity": {
      "type": "string",
      "enum": [
        "Simple",
        "Standard",
        "Complex"
      ]
    },
    "assessment_pool_spa": {
      "type": "boolean",
      "default": false
    },
    "assessment_multiple_floors": {
      "type": "boolean",
      "default": false
    },
    "assessment_outbuilding": {
      "type": "boolean",
      "default": false
    },
    "assessment_extensive_grounds": {
      "type": "boolean",
      "default": false
    },
    "assessment_difficult_access": {
      "type": "boolean",
      "default": false
    },
    "assessment_special_monitoring": {
      "type": "boolean",
      "default": false
    },
    "assessment_visit_time": {
      "type": "string",
      "enum": [
        "Up to 15 minutes",
        "30\u201345 minutes",
        "Up to 60 minutes",
        "More than 60 minutes"
      ]
    },
    "assessment_note": {
      "type": "string"
    },
    "assessment_service_area": {
      "type": "string",
      "enum": [
        "Within normal service area",
        "Outside normal service area / review required"
      ],
      "default": "Within normal service area"
    },
    "assessment_completed_at": {
      "type": "string"
    },
    "assessment_completed_by": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}