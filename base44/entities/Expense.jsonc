{
  "name": "Expense",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Optional expense category (e.g. Materials, Contractor, Utilities). Shown in the property activity report; empty = not recorded."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "receipt_photo": {
      "type": "string"
    },
    "paid_by": {
      "type": "string"
    },
    "awaiting_reimbursement": {
      "type": "boolean",
      "default": false
    },
    "reimbursed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "visit_id": {
      "type": "string"
    },
    "maintenance_issue_id": {
      "type": "string"
    },
    "contractor_id": {
      "type": "string"
    }
  },
  "required": [
    "vendor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}