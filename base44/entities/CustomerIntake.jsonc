{
  "name": "CustomerIntake",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "secure_token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Received",
        "Reviewed",
        "Applied",
        "Archived"
      ],
      "default": "Draft"
    },
    "sent_at": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "applied_at": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "description": {
      "type": "string",
      "description": "Optional free-text description (up to 1000 characters).",
      "maxLength": 1000
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "secure_token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}