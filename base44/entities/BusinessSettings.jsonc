{
  "name": "BusinessSettings",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "logo": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "vat_rate": {
      "type": "number",
      "default": 24
    },
    "default_checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "English",
        "Greek"
      ],
      "default": "English"
    },
    "reminder_offsets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notif_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quick_notes": {
      "type": "string"
    }
  }
}