{
  "name": "BusinessSettings",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Trading / display name of the business."
    },
    "legal_business_name": {
      "type": "string",
      "description": "Legal business name, used when different from the trading name (customer-facing documents). Empty = same as trading name."
    },
    "logo": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "description": "Business website (optional)."
    },
    "address": {
      "type": "string"
    },
    "vat_number": {
      "type": "string",
      "description": "Greek AFM / VAT number. Shown on customer-facing invoices when configured."
    },
    "tax_office": {
      "type": "string",
      "description": "DOY / tax office (optional). Shown on customer-facing invoices when configured."
    },
    "business_activity": {
      "type": "string",
      "description": "Business activity / profession description (optional)."
    },
    "bank_name": {
      "type": "string",
      "description": "Business bank name. Customer-facing payment instruction \u2014 appears on generated invoices only, never on public/internal surfaces."
    },
    "bank_beneficiary": {
      "type": "string",
      "description": "Account holder / beneficiary for customer payments. Customer-facing payment instruction."
    },
    "bank_iban": {
      "type": "string",
      "description": "Business IBAN for customer payments. Customer-facing payment instruction."
    },
    "bank_bic": {
      "type": "string",
      "description": "BIC / SWIFT code (optional). Customer-facing payment instruction."
    },
    "payment_instructions": {
      "type": "string",
      "description": "Optional payment-instructions note shown beneath the invoice payment information (e.g. include the invoice number with your payment)."
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "vat_rate": {
      "type": "number",
      "default": 24
    },
    "default_checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "English",
        "Greek"
      ],
      "default": "English"
    },
    "reminder_offsets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Global default reminder timing (offset keys: 'due','1h','1d','3d','7d'). Backward-compatible fallback for any category without its own stored selection. Kept for existing accounts."
    },
    "reminder_offsets_by_category": {
      "type": "object",
      "description": "Per-category reminder timing selections: category name -> array of offset keys ('due','1h','1d','3d','7d'). A stored array (even empty) is that category's own selection; a category with NO stored array falls back to the global reminder_offsets. Timing selections are preserved when a category is switched OFF.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "notif_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quick_notes": {
      "type": "string"
    },
    "owner_profile_name": {
      "type": "string",
      "description": "Owner's display name shown in the public landing page 'Meet your local contact' section."
    },
    "owner_profile_photo": {
      "type": "string",
      "description": "Owner's profile photo (public file URL) for the landing page contact section. Empty = placeholder avatar."
    },
    "owner_profile_intro_en": {
      "type": "string",
      "description": "Owner's short personal introduction, English version, for the landing page contact section."
    },
    "owner_profile_intro_el": {
      "type": "string",
      "description": "Owner's short personal introduction, Greek version, for the landing page contact section."
    },
    "owner_profile_phone": {
      "type": "string",
      "description": "Owner's phone number shown on the public landing page contact section."
    },
    "owner_profile_email": {
      "type": "string",
      "description": "Owner's email shown on the public landing page contact section."
    },
    "owner_profile_whatsapp": {
      "type": "string",
      "description": "Owner's WhatsApp number shown on the public landing page contact section."
    },
    "owner_profile_local_photo": {
      "type": "string",
      "description": "Genuine local / property photo (public file URL) shown beneath the owner profile on the landing page. Empty = placeholder."
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}