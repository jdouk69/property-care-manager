{
  "name": "PropertyVisit",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "Monthly Property Watch",
        "Home Watch Inspection",
        "Property Care Inspection",
        "Owner Arrival Preparation",
        "Guest Arrival Preparation",
        "Departure Inspection",
        "Seasonal Opening",
        "Seasonal Closing",
        "Emergency Visit",
        "Owner Representative Construction Visit",
        "Owner Representative Site Visit"
      ],
      "default": "Monthly Property Watch"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "In Progress"
    },
    "gps_location": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Normal",
              "Important",
              "Emergency",
              "Not Checked"
            ],
            "default": "Not Checked"
          },
          "notes": {
            "type": "string"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "meter_readings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "follow_up_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintenance_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_report": {
      "type": "string"
    },
    "report_sent": {
      "type": "boolean",
      "default": false
    },
    "property_service_agreement_id": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "property_id"
  ]
}