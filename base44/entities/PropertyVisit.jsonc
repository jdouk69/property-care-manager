{
  "name": "PropertyVisit",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "Monthly Property Watch",
        "Owner Arrival Preparation",
        "Guest Arrival Preparation",
        "Departure Inspection",
        "Seasonal Opening",
        "Seasonal Closing",
        "Owner Representative Construction Visit",
        "Home Watch Inspection",
        "Property Care Inspection",
        "Complete Care Property Visit",
        "Complete Care Follow-up Visit",
        "Emergency Visit",
        "Owner Representative Site Visit",
        "Initial Property Onboarding Inspection",
        "Property Assistance",
        "On-Demand Property Assistance",
        "Grocery Stocking"
      ],
      "default": "Monthly Property Watch"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "In Progress"
    },
    "gps_location": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Normal",
              "Important",
              "Emergency",
              "Unable to Check",
              "N/A",
              "Not Checked"
            ],
            "default": "Not Checked"
          },
          "notes": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "action_taken": {
            "type": "string"
          },
          "owner_visible": {
            "type": "boolean",
            "default": false
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "meter_readings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "follow_up_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintenance_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_report": {
      "type": "string"
    },
    "report_sent": {
      "type": "boolean",
      "default": false
    },
    "report_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Ready to Send",
        "Sent",
        "Delivery Failed"
      ],
      "default": "Draft"
    },
    "report_pdf_url": {
      "type": "string",
      "description": "The approved report PDF. Private storage URI for reports approved after the secure-access change (accessed via short-lived signed URLs / email attachments); legacy records may still hold an old public URL."
    },
    "report_content_hash": {
      "type": "string",
      "description": "Fingerprint of the report data captured when the PDF was approved. A changed fingerprint invalidates the stored PDF \u2014 re-approval is required before sending."
    },
    "report_reviewed_at": {
      "type": "string",
      "description": "When the report was last approved (reviewed) by staff."
    },
    "report_reviewed_by": {
      "type": "string",
      "description": "Who approved the report for sending."
    },
    "report_sent_at": {
      "type": "string"
    },
    "report_sent_to": {
      "type": "string"
    },
    "report_sent_by": {
      "type": "string"
    },
    "report_delivery_method": {
      "type": "string"
    },
    "photo_update_note": {
      "type": "string",
      "description": "Staff-authored short note sent with the Complete Care follow-up photo update. Empty = no note."
    },
    "photo_update_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The 1\u20133 visit photos (storage URIs / URLs) explicitly selected by staff for the dated photo update emailed to the owner."
    },
    "photo_update_sent_at": {
      "type": "string",
      "description": "When the follow-up photo update was emailed to the owner. Presence of this field is the duplicate-send guard \u2014 the send action requires explicit confirmation to run again."
    },
    "photo_update_sent_to": {
      "type": "string",
      "description": "Owner email address the photo update was sent to. Comes only from the linked client record \u2014 never guessed."
    },
    "photo_update_sent_by": {
      "type": "string",
      "description": "Which staff member sent the photo update."
    },
    "duration_review": {
      "type": "object",
      "description": "Staff decision about a flagged multi-day visit duration (visits left open across days). The original start/end timestamps are NEVER modified. state 'confirmed' = the recorded gap is accurate; 'corrected' = use verified_minutes in the customer report (reason required); 'omitted' = show no duration in the report.",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "confirmed",
            "corrected",
            "omitted"
          ]
        },
        "verified_minutes": {
          "type": "number",
          "description": "Staff-verified actual visit duration in minutes (only for state 'corrected')."
        },
        "reason": {
          "type": "string",
          "description": "Why the recorded duration was corrected or omitted (required for 'corrected')."
        },
        "reviewed_at": {
          "type": "string",
          "description": "When the duration decision was made (at report approval)."
        },
        "reviewed_by": {
          "type": "string",
          "description": "Who made the duration decision."
        }
      }
    },
    "property_service_agreement_id": {
      "type": "string"
    },
    "is_additional_service": {
      "type": "boolean",
      "default": false,
      "description": "True when this visit is an ADDITIONAL requested service beyond the package's included visits for the period \u2014 never counted against the included allowance."
    },
    "billing_classification": {
      "type": "string",
      "enum": [
        "Included in Package",
        "Additional - Billable",
        "Courtesy - No Charge"
      ],
      "description": "Final billing classification of a package visit, decided automatically from entitlement data. Additional visits default to 'Additional - Billable'; staff may uncheck the Billable override before completing, which stores 'Courtesy - No Charge' (no customer charge). Empty for non-package visits (one-time services, assistance, grocery, no-agreement properties)."
    },
    "agreed_price": {
      "type": "number"
    },
    "additional_minutes": {
      "type": "number",
      "default": 0
    },
    "additional_labor_charge": {
      "type": "number",
      "default": 0
    },
    "materials_charge": {
      "type": "number",
      "default": 0
    },
    "vat_amount": {
      "type": "number",
      "default": 0
    },
    "vat_rate_snapshot": {
      "type": "number",
      "default": 0
    },
    "final_total": {
      "type": "number"
    },
    "travel_charge": {
      "type": "number",
      "default": 0
    },
    "request_description": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pricing_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "shopping_list": {
      "type": "string"
    },
    "grocery_cost": {
      "type": "number",
      "default": 0
    },
    "owner_approval": {
      "type": "object",
      "description": "Per-visit owner approval recorded BEFORE staff perform the work (required for Seasonal Opening / Seasonal Closing). Captures the specific approved tasks, approved price, access/key instructions and any extra-time approval, plus how the owner's approval was given \u2014 the evidence behind 'agreed in writing'.",
      "properties": {
        "approved_via": {
          "type": "string",
          "enum": [
            "Email",
            "WhatsApp",
            "Phone",
            "In-person",
            "Signed document"
          ]
        },
        "approved_reference": {
          "type": "string",
          "description": "Where the approval is recorded (e.g. email subject and date, WhatsApp message date) \u2014 the evidence behind 'agreed in writing'."
        },
        "approved_tasks": {
          "type": "string",
          "description": "The specific opening/closing steps the owner approved for this visit."
        },
        "approved_price": {
          "type": "number",
          "description": "The price the owner approved for this visit."
        },
        "key_instructions": {
          "type": "string",
          "description": "The owner's recorded access / key return-or-store instructions for this visit."
        },
        "extra_time_approved": {
          "type": "boolean",
          "default": false,
          "description": "True when the owner pre-approved extra time beyond the included allowance at the agreed hourly rate."
        },
        "approved_at": {
          "type": "string",
          "description": "When the owner's approval was recorded."
        },
        "recorded_by": {
          "type": "string",
          "description": "Which staff member recorded the approval."
        }
      }
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "property_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}