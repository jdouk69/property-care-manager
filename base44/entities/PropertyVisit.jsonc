{
  "name": "PropertyVisit",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "Monthly Property Watch",
        "Owner Arrival Preparation",
        "Guest Arrival Preparation",
        "Departure Inspection",
        "Seasonal Opening",
        "Seasonal Closing",
        "Owner Representative Construction Visit",
        "Home Watch Inspection",
        "Property Care Inspection",
        "Emergency Visit",
        "Owner Representative Site Visit",
        "Initial Property Onboarding Inspection",
        "Property Assistance"
      ],
      "default": "Monthly Property Watch"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "In Progress"
    },
    "gps_location": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Normal",
              "Important",
              "Emergency",
              "Not Checked"
            ],
            "default": "Not Checked"
          },
          "notes": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "action_taken": {
            "type": "string"
          },
          "owner_visible": {
            "type": "boolean",
            "default": false
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "meter_readings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "follow_up_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maintenance_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_report": {
      "type": "string"
    },
    "report_sent": {
      "type": "boolean",
      "default": false
    },
    "report_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Ready to Send",
        "Sent",
        "Delivery Failed"
      ],
      "default": "Draft"
    },
    "report_pdf_url": {
      "type": "string"
    },
    "report_sent_at": {
      "type": "string"
    },
    "report_sent_to": {
      "type": "string"
    },
    "report_sent_by": {
      "type": "string"
    },
    "report_delivery_method": {
      "type": "string"
    },
    "property_service_agreement_id": {
      "type": "string"
    },
    "agreed_price": {
      "type": "number"
    },
    "additional_minutes": {
      "type": "number",
      "default": 0
    },
    "additional_labor_charge": {
      "type": "number",
      "default": 0
    },
    "materials_charge": {
      "type": "number",
      "default": 0
    },
    "vat_amount": {
      "type": "number",
      "default": 0
    },
    "vat_rate_snapshot": {
      "type": "number",
      "default": 0
    },
    "final_total": {
      "type": "number"
    },
    "travel_charge": {
      "type": "number",
      "default": 0
    },
    "request_description": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "property_id"
  ]
}