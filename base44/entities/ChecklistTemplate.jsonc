{
  "name": "ChecklistTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional free-text description shown in the Checklist Templates admin screen."
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "Monthly Property Watch",
        "Owner Arrival Preparation",
        "Guest Arrival Preparation",
        "Departure Inspection",
        "Seasonal Opening",
        "Seasonal Closing",
        "Owner Representative Construction Visit",
        "Home Watch Inspection",
        "Property Care Inspection",
        "Complete Care Property Visit",
        "Emergency Visit",
        "Owner Representative Site Visit",
        "Initial Property Onboarding Inspection",
        "Grocery Stocking"
      ],
      "default": "Monthly Property Watch"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_master": {
      "type": "boolean",
      "default": true
    },
    "property_id": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}