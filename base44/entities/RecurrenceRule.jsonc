{
  "name": "RecurrenceRule",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "Task",
        "Inspection"
      ],
      "default": "Task"
    },
    "title": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "inspector": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Biweekly",
        "Monthly",
        "Bimonthly",
        "Quarterly",
        "Semiannual",
        "Yearly",
        "Custom"
      ],
      "default": "Weekly"
    },
    "interval": {
      "type": "number",
      "default": 1
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "day_of_month": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "reminder_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "ended"
      ],
      "default": "active"
    },
    "next_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "frequency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}