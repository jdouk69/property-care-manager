{
  "name": "BillingCharge",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_service_agreement_id": {
      "type": "string"
    },
    "visit_id": {
      "type": "string"
    },
    "expense_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "charge_type": {
      "type": "string",
      "enum": [
        "Service",
        "Visit",
        "Reimbursement",
        "Other"
      ],
      "default": "Service"
    },
    "billing_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Due",
        "Paid",
        "Waived"
      ],
      "default": "Due"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Bank Transfer",
        "IRIS",
        "Cash",
        "Wise",
        "Revolut",
        "Other"
      ]
    },
    "payment_reference": {
      "type": "string"
    },
    "payments": {
      "type": "array",
      "description": "Audit-trail of manually confirmed payments (NEVER inferred from a QR scan, screenshot or invoice send). Each entry: amount, date, method, optional bank reference, recorded_by/recorded_at. Corrections VOID an entry (voided + voided_at/voided_by/void_reason kept visible) \u2014 entries are never deleted. Legacy records with status Paid and no entries are adopted as a legacy entry on first correction. Partially paid = balance outstanding; stored status only becomes Paid when fully paid.",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "enum": [
              "Bank Transfer",
              "IRIS",
              "Cash",
              "Wise",
              "Revolut",
              "Other"
            ]
          },
          "reference": {
            "type": "string"
          },
          "recorded_by": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string"
          },
          "voided": {
            "type": "boolean",
            "default": false
          },
          "voided_at": {
            "type": "string"
          },
          "voided_by": {
            "type": "string"
          },
          "void_reason": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "date",
          "method"
        ]
      }
    },
    "notes": {
      "type": "string"
    },
    "source_key": {
      "type": "string"
    },
    "billing_period": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "description",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}