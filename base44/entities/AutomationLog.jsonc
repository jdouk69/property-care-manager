{
  "name": "AutomationLog",
  "type": "object",
  "properties": {
    "date_time": {
      "type": "string"
    },
    "automation_type": {
      "type": "string"
    },
    "record_created": {
      "type": "string"
    },
    "related_property_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ],
      "default": "success"
    },
    "error_details": {
      "type": "string"
    }
  },
  "required": [
    "automation_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}