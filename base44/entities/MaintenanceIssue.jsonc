{
  "name": "MaintenanceIssue",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Plumbing",
        "Electrical",
        "Pool",
        "Irrigation",
        "Garden",
        "Air conditioning",
        "Heating",
        "Appliance",
        "Internet",
        "Security",
        "Locksmith",
        "Cleaning",
        "Painting",
        "Building repair",
        "Pest control",
        "Storm damage",
        "Other"
      ],
      "default": "Other"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Routine",
        "Medium",
        "High",
        "Emergency"
      ],
      "default": "Medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "Reported",
        "Awaiting Owner Approval",
        "Approved",
        "Contractor Contacted",
        "Scheduled",
        "In Progress",
        "Waiting for Parts",
        "Waiting for Payment",
        "Completed",
        "Cancelled"
      ],
      "default": "Reported"
    },
    "description": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "source_visit_id": {
      "type": "string"
    },
    "contractor_id": {
      "type": "string"
    },
    "contractor_quotation": {
      "type": "number"
    },
    "owner_approval_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    },
    "scheduled_appointment": {
      "type": "string",
      "format": "date"
    },
    "cost_estimate": {
      "type": "number"
    },
    "final_cost": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Unpaid",
        "Partially Paid",
        "Paid"
      ],
      "default": "Unpaid"
    },
    "before_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "during_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "after_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "note"
        ]
      }
    },
    "completion_notes": {
      "type": "string"
    },
    "resolution_note": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "warranty_info": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "coordination_fee": {
      "type": "number"
    },
    "coordination_fee_offer_sent_at": {
      "type": "string"
    },
    "coordination_fee_offer_amount": {
      "type": "number"
    },
    "coordination_fee_offer_sent_to": {
      "type": "string"
    },
    "coordination_fee_offer_message_id": {
      "type": "string"
    },
    "coordination_fee_approved": {
      "type": "boolean"
    },
    "coordination_fee_decision": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Declined"
      ]
    },
    "coordination_fee_approved_amount": {
      "type": "number"
    },
    "coordination_fee_approval_channel": {
      "type": "string",
      "enum": [
        "Email",
        "WhatsApp",
        "SMS"
      ]
    },
    "coordination_fee_approval_note": {
      "type": "string"
    },
    "owner_report_sent_at": {
      "type": "string"
    },
    "owner_report_sent_to": {
      "type": "string"
    },
    "owner_report_message_id": {
      "type": "string"
    },
    "owner_action": {
      "type": "string",
      "enum": [
        "Owner will handle it",
        "Please coordinate",
        "Declined"
      ]
    },
    "owner_action_at": {
      "type": "string"
    },
    "owner_action_by": {
      "type": "string"
    },
    "owner_action_channel": {
      "type": "string",
      "enum": [
        "Email",
        "WhatsApp",
        "SMS",
        "Phone",
        "In-person"
      ]
    },
    "owner_action_note": {
      "type": "string"
    },
    "contractor_quote_file": {
      "type": "string"
    },
    "contractor_quote_file_name": {
      "type": "string"
    },
    "contractor_quote_file_size": {
      "type": "number"
    },
    "contractor_quote_file_type": {
      "type": "string"
    },
    "approved_max_spend": {
      "type": "number"
    },
    "repair_approval_channel": {
      "type": "string",
      "enum": [
        "Email",
        "WhatsApp",
        "SMS",
        "Phone",
        "In-person"
      ]
    },
    "repair_approval_note": {
      "type": "string"
    },
    "repair_approval_request_sent_at": {
      "type": "string"
    },
    "repair_approval_request_sent_to": {
      "type": "string"
    },
    "repair_approval_request_message_id": {
      "type": "string"
    },
    "repair_work_description": {
      "type": "string"
    },
    "linked_contractor_visit_id": {
      "type": "string"
    },
    "receipt_file": {
      "type": "string"
    },
    "receipt_file_name": {
      "type": "string"
    },
    "proposed_max_spend": {
      "type": "number"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
