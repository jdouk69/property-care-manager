{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_service_agreement_id": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "services": {
      "type": "string"
    },
    "expenses_total": {
      "type": "number"
    },
    "reimbursements_total": {
      "type": "number"
    },
    "vat": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "amount_paid": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Partially Paid",
        "Paid",
        "Overdue",
        "Cancelled"
      ],
      "default": "Draft"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "finalized_at": {
      "type": "string",
      "description": "ISO timestamp when the invoice was finalized (locked) for issuance. Status remains Draft until it is actually Sent; the presence of finalized_at locks financial/identity editing."
    },
    "sent_at": {
      "type": "string",
      "description": "ISO timestamp of the successful email delivery to the customer. Never recorded when delivery fails."
    },
    "sent_to": {
      "type": "string",
      "description": "Customer email address the invoice was emailed to. Comes only from the linked client record \u2014 never guessed."
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "billing_period": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "description"
        ]
      }
    },
    "charge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payment_details_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "description": "Payment details (bank-issued IRIS QR + bank transfer settings) frozen when the invoice was finalized, so already-issued documents keep the payment details they were issued with. Legacy issued invoices may have no snapshot \u2014 they keep their pre-IRIS look."
    }
  },
  "required": [
    "invoice_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}