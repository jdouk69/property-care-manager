{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Task",
        "Inspection",
        "Maintenance",
        "Contractor",
        "Visit",
        "System"
      ],
      "default": "System"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "dedup_key": {
      "type": "string"
    },
    "related_entity": {
      "type": "string"
    },
    "related_record_id": {
      "type": "string"
    },
    "related_property_id": {
      "type": "string"
    },
    "related_path": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional free-text description (up to 1000 characters).",
      "maxLength": 1000
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}