{
  "name": "Inspection",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "inspector": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Completed"
      ],
      "default": "Draft"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "summary_notes": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_id": {
      "type": "string"
    },
    "occurrence_date": {
      "type": "string",
      "format": "date"
    },
    "recurrence_status": {
      "type": "string",
      "enum": [
        "active",
        "skipped",
        "ended"
      ],
      "default": "active"
    },
    "repeat_label": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pass",
              "Needs Attention",
              "Critical",
              "Not Checked"
            ],
            "default": "Not Checked"
          },
          "notes": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "property_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}