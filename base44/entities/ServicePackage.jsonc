{
  "name": "ServicePackage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "standard_price": {
      "type": "number"
    },
    "service_tier": {
      "type": "string",
      "enum": [
        "Basic",
        "Standard",
        "Premium"
      ]
    },
    "one_time_price": {
      "type": "number"
    },
    "billing_type": {
      "type": "string",
      "enum": [
        "One-time",
        "Monthly",
        "Quarterly",
        "Annual"
      ],
      "default": "Monthly"
    },
    "recurring": {
      "type": "string",
      "enum": [
        "One-time",
        "Recurring"
      ],
      "default": "Recurring"
    },
    "visit_duration": {
      "type": "string"
    },
    "inspection_frequency": {
      "type": "string"
    },
    "included_visits_per_period": {
      "type": "number",
      "default": 1,
      "description": "Included scheduled visits per service (billing) period \u2014 drives the package visit entitlement display. Default 1."
    },
    "default_visit_type": {
      "type": "string"
    },
    "hourly_charge": {
      "type": "number"
    },
    "travel_charge": {
      "type": "number"
    },
    "emergency_surcharge": {
      "type": "number"
    },
    "vat_setting": {
      "type": "string",
      "enum": [
        "Included",
        "Exempt",
        "Standard 24%"
      ],
      "default": "Standard 24%"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}