{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "English",
        "Greek"
      ],
      "default": "English"
    },
    "preferred_communication_method": {
      "type": "string",
      "enum": [
        "WhatsApp",
        "Email",
        "Phone",
        "SMS"
      ],
      "default": "WhatsApp"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "billing_address": {
      "type": "string"
    },
    "tax_invoice_info": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive"
      ],
      "default": "Active"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}