{
  "name": "PropertyDocument",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "maintenance_issue_id": {
      "type": "string"
    },
    "visit_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Quotes",
        "Invoices",
        "Contracts",
        "Warranties",
        "Manuals",
        "Insurance Documents",
        "Utility Documents",
        "Floor Plans",
        "Photos",
        "Miscellaneous Files"
      ],
      "default": "Miscellaneous Files"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "date_taken": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}