{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/Athens",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Anniversary recurring billing: one charge + linked Draft invoice per service period for Active + Signed monthly agreements, billed on each agreement's service-start anniversary (no proration). Runs daily at 03:00 (Europe/Athens); per-period source keys + post-write uniqueness make retries/concurrent runs duplicate-free.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recurring_charges",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_charges": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateRecurringCharges"
          },
          "then": "end",
          "x-base44": {
            "title": "Generate anniversary charges",
            "description": "Anniversary charge + draft invoice per service period"
          }
        }
      }
    ]
  },
  "name": "Recurring Charges"
}