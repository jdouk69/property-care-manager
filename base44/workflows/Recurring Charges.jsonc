{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/Athens",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Generates the current month's recurring billing charges from Active + Signed service agreements. Runs daily at 03:00 (Europe/Athens); duplicate protection (agreement ID + billing period) makes it idempotent, so each agreement gets exactly one charge per month.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recurring_charges",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_charges": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateRecurringCharges"
          },
          "then": "end",
          "x-base44": {
            "title": "Generate recurring charges",
            "description": "Monthly charges from Active + Signed agreements"
          }
        }
      }
    ]
  },
  "name": "Recurring Charges"
}