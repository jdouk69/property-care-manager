{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Athens",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Generates scheduled-visit reminders (1h/1d/3d/7d, due) and missed-visit alerts every hour, Europe/Athens.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "visit_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateVisitReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Generate visit reminders",
            "description": "Scan scheduled visits and create reminders + missed alerts"
          }
        }
      }
    ]
  },
  "name": "Visit Reminders"
}